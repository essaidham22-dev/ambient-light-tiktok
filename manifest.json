{
  "manifest_version": 3,
  "name": "Ambient Light for TikTok",
  "version": "1.0.0",
  "description": "Reactive, glowing ambient lighting around TikTok Web videos.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Light for TikTok",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["*://*.tiktok.com/*"],
    "js": ["defaults.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Toggle Ambient Light on/off"
    }
  }
}
